# ─────────────────────────────────────────────────────────────
# Nexus AI — environment variables
# Copy this file to `.env` (or `.env.local`) and fill in the values.
# ─────────────────────────────────────────────────────────────

# Supabase — create a free project at https://supabase.com
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used for privileged operations.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — powers chat + document embeddings (RAG)
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional — enable additional models for per-assistant routing.
# When absent, those assistants gracefully fall back to Gemini.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
